# 이 파일을 복사해서 .env.local로 저장하고 실제 값을 채워 넣으세요.
# .env.local은 .gitignore에 등록되어 있어 깃허브에 올라가지 않습니다.

# platform.openai.com 에서 발급받은 API 키
OPENAI_API_KEY=

# Google Cloud Console에서 발급받은 OAuth 클라이언트 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# node scripts/google-auth.js 실행 후 나오는 값을 붙여넣으세요
GOOGLE_REFRESH_TOKEN=

# supabase.com 프로젝트 Settings > API 에서 확인
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
