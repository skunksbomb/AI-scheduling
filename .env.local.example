# 이 파일을 복사해서 .env.local로 저장하고 실제 값을 채워 넣으세요.
# .env.local은 .gitignore에 등록되어 있어 깃허브에 올라가지 않습니다.

# platform.openai.com 에서 발급받은 API 키
OPENAI_API_KEY=

# (선택) dump 파싱/배치 판단/피드백 저장 판단에 쓸 모델. 비워두면 gpt-4o 사용.
# gpt-4o-mini로는 "개인 컨텍스트 + 날짜 표현" 같은 복합 판단을 자꾸 틀려서
# (예: "다음주 서울 갔을 때 ~하기") 전부 이 모델을 쓰도록 통일함.
OPENAI_PLACEMENT_MODEL=

# Google Cloud Console에서 발급받은 OAuth 클라이언트 정보 (웹 애플리케이션 타입,
# 승인된 리디렉션 URI에 {APP_BASE_URL}/api/auth/callback 등록 필요)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# supabase.com 프로젝트 Settings > API 에서 확인
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 로그인 세션 쿠키 서명용 (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# 로컬은 http://localhost:3000, 배포본은 실제 도메인
APP_BASE_URL=
